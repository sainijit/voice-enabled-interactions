# Model binary files are downloaded by setup_models.sh and baked into the
# Docker image at build time (COPY . . in the Dockerfile). They must not be
# committed to git — binary blobs inflate repo size and make history rewrites
# painful (see the HF token incident).
#
# To populate this directory before building:
#   ./setup_models.sh          # downloads yolo26n IR to queue-service/models/
#   docker compose build       # bakes the IR into the queue-service image
#
# The _static variant is auto-generated by model_manager.py on first run
# inside the container (ensure_static_ir reshapes the dynamic batch dim).

# Ignore all IR, weight, config and metadata files
*.xml
*.bin
*.json
*.pt
*.onnx

# Keep this file and .gitkeep
!.gitignore
!.gitkeep
